# Copy to .env yourself; fill placeholders privately. No existing .env is changed by the agent.
POSTGRES_DB=swasthmode
POSTGRES_USER=swasthmode
POSTGRES_PASSWORD=replace_with_local_database_password
# Used when running the backend on the host. Percent-encode special characters in the URL password.
DATABASE_URL=postgresql+psycopg://swasthmode:replace_with_local_database_password@localhost:5432/swasthmode
# Used by API/worker containers. Keep credentials consistent with the values above.
DOCKER_DATABASE_URL=postgresql+psycopg://swasthmode:replace_with_local_database_password@postgres:5432/swasthmode
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:5173
# Clerk development instance. Only the publishable key is provided to the frontend.
VITE_CLERK_PUBLISHABLE_KEY=replace_with_clerk_development_publishable_key
CLERK_SECRET_KEY=replace_with_clerk_development_secret_key
CLERK_ISSUER=https://replace-with-your-instance.clerk.accounts.dev
# Optional PEM public key from the SAME development instance. Encode newlines as literal \n.
CLERK_JWT_KEY=
# Text AI: use a model/deployment that supports strict structured outputs.
AI_PROVIDER=openai
AI_API_KEY=replace_with_text_ai_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=replace_with_structured_output_model_or_deployment
# Required for AI_PROVIDER=azure; AI_BASE_URL must then be your Azure resource endpoint.
AI_API_VERSION=
PROVIDER_TIMEOUT_SECONDS=25
PROVIDER_RETRIES=1
TURN_TIMEOUT_SECONDS=80
TURN_LEASE_SECONDS=120
CONVERSATION_HOURS=24
# Hybrid is the default: our rules plus NeMo. No silent fallback on safety failure.
GUARDRAILS_MODE=hybrid
# Explicitly choose a safety-check model/deployment on the AI_BASE_URL provider.
# It may be the same as AI_MODEL, but configure it deliberately.
NEMO_MODEL=replace_with_safety_check_model_or_deployment
# Optional separate key; if blank the backend uses AI_API_KEY. Never exposed to Vite.
NEMO_API_KEY=
NEMO_TIMEOUT_SECONDS=12
NEMO_MAX_TOKENS=1024
# Phase 5 voice: backend-only credentials. STT uses an OpenAI-compatible
# /audio/transcriptions endpoint supporting WebM/Opus and JSON responses.
# STT_BASE_URL is the API root (such as https://api.openai.com/v1), not the full route.
STT_API_KEY=replace_with_transcription_key
STT_BASE_URL=replace_with_webm_opus_capable_endpoint
STT_MODEL=replace_with_transcription_model_or_deployment
CARTESIA_API_KEY=replace_with_cartesia_key
CARTESIA_VOICE_ID=replace_with_cartesia_voice_id
CARTESIA_MODEL=replace_with_cartesia_model
SPEECH_TIMEOUT_SECONDS=45
# Local Flower basic authentication, username:password.
FLOWER_BASIC_AUTH=replace_with_flower_user:replace_with_flower_password
